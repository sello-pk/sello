# Optional: OpenAI for car estimator GPT adjustment (https://platform.openai.com/api-keys).
# Without this, valuations use listing data + rules only (no Chat Completions usage).
# OPENAI_API_KEY=sk-...
# Alternate name supported by code: OPENAI_KEY

# Car Compare uses JAG9 ONLY (Chat Completions extraction).
# Stage A fetches Pakistan web pages; Stage B asks JAG9 to extract JSON from that text.
# Live web search is NOT performed by JAG9 on this path.
# Required (fail loud if missing):
# JAG9_API_KEY=
# JAG9_BASE_URL=https://your-jag9-host/v1
# JAG9_MODEL=your-model-id
# Aliases still accepted:
# COMPARE_AI_API_KEY=
# COMPARE_AI_BASE_URL=
# COMPARE_AI_MODEL=
# Optional research cache TTL (ms). Default 12 hours.
# COMPARE_RESEARCH_CACHE_TTL_MS=43200000
# Optional pricing overrides used by cost monitoring. Estimates exclude taxes and discounts.
# COMPARE_INPUT_USD_PER_MILLION=2
# COMPARE_CACHED_USD_PER_MILLION=0.5
# COMPARE_OUTPUT_USD_PER_MILLION=8
# COMPARE_SEARCH_USD_PER_CALL=0.01

# When mongodb+srv DNS fails locally, set shard hosts (comma-separated host:port):
# MONGO_DIRECT_HOSTS=host1:27017,host2:27017,host3:27017

# Optional: Cloudinary listing uploads (defaults: concurrency 3, retries 3)
# Adaptive scheduling may use 2-4 based on total payload; cap with MAX_CONCURRENCY.
# CLOUDINARY_UPLOAD_CONCURRENCY=3
# CLOUDINARY_UPLOAD_MAX_CONCURRENCY=4
# CLOUDINARY_UPLOAD_RETRIES=3

# Optional: prevent accidental duplicate listing creation from double-click/retry.
# Server returns existing listing if an identical one was just created by same user.
# CREATE_CAR_DEDUP_WINDOW_MINUTES=15

# Meta Vehicle Catalog CSV (/feed/cars.csv): absolute links & images (default https://sello.pk)
# META_CATALOG_SITE_URL=https://sello.pk

# Cache full CSV in memory (seconds). Default 420 (7 minutes) if unset or invalid.
# META_CATALOG_CACHE_SECONDS=420

# IndexNow (Bing URL notify on listing publish/update/remove). Key file must be
# publicly reachable at https://sello.pk/{INDEXNOW_KEY}.txt (also in client/public).
