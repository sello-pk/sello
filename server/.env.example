# Optional: Cloudinary listing uploads (defaults: concurrency 3, retries 3)
# Adaptive scheduling may use 2-4 based on total payload; cap with MAX_CONCURRENCY.
# CLOUDINARY_UPLOAD_CONCURRENCY=3
# CLOUDINARY_UPLOAD_MAX_CONCURRENCY=4
# CLOUDINARY_UPLOAD_RETRIES=3

# Optional: prevent accidental duplicate listing creation from double-click/retry.
# Server returns existing listing if an identical one was just created by same user.
# CREATE_CAR_DEDUP_WINDOW_MINUTES=15

# Meta Vehicle Catalog CSV (/feed/cars.csv): absolute links & images (default https://sello.pk)
# META_CATALOG_SITE_URL=https://sello.pk

# Cache full CSV in memory (seconds). Default 420 (7 minutes) if unset or invalid.
# META_CATALOG_CACHE_SECONDS=420
